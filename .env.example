# URL สาธารณะของระบบ (ใช้ทำลิงก์ในการ์ด LINE และลิงก์รูป — ต้องเป็น https)
APP_URL=https://message.songnam.xyz

# LINE Messaging API
LINE_TOKEN=
LINE_TO=                       # groupId/userId คั่นด้วย ,  (TestGroup: Cb8049864768d723040c24140baf9bedb)
LINE_CHANNEL_SECRET=           # (ไม่บังคับ) ใช้ตรวจลายเซ็น webhook ที่ /webhook

# LINE Login (นักเรียนต้องเข้าสู่ระบบก่อนส่งเรื่อง) — สร้างช่อง LINE Login ใต้ Provider เดียวกับบอท
# Callback URL ที่ต้องตั้งในช่อง LINE Login: https://message.songnam.xyz/auth/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
STUDENT_SESSION_DAYS=30

# ค่าจาก Apps Script เดิม — ใส่ไว้เพื่อให้รหัสผ่านผู้ดูแลเดิมใช้ได้ต่อ
SALT=
ADMIN_HASH=

# ตัวเลือกอื่น
LINE_IMAGES=true               # false = รูปดูได้เฉพาะผู้ดูแลที่ล็อกอิน (ไม่ส่งรูปเข้า LINE)
MAX_VIDEO_MB=50                # ขนาดวิดีโอสูงสุดต่อไฟล์ (ต้องไม่เกิน client_max_body_size ใน nginx)
SESSION_HOURS=12
# LOGO_URL=https://...
